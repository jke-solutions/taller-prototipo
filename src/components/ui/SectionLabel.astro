---
/**
 * Rótulo de sección: eyebrow en mayúsculas + regla naranja debajo.
 * Se repite en "Explora por categoría", "Producto destacado" y "En promoción".
 * Slot opcional `action` para el link a la derecha (ej. "Ver todas").
 */
interface Props {
  eyebrow: string;
  /** Línea divisoria arriba del bloque (como el primer rótulo del Home). */
  withBorderTop?: boolean;
  class?: string;
}

const { eyebrow, withBorderTop = false, class: className } = Astro.props;
const hasAction = Astro.slots.has('action');
---

<div
  class:list={[
    'bg-white pt-12 pb-6',
    withBorderTop && 'border-t border-border',
    className,
  ]}
>
  <div class="wrap" data-reveal>
    <div class:list={['flex items-center', hasAction ? 'justify-between' : 'justify-start']}>
      <p class="section-eyebrow">{eyebrow}</p>
      {hasAction && <slot name="action" />}
    </div>
    <div class="accent-rule mt-[14px]"></div>
  </div>
</div>
