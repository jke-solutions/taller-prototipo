---
/**
 * Sprite SVG inline. Se incluye UNA sola vez en el layout base; los
 * componentes referencian cada ícono con <use href="#ic-{name}"> vía <Icon />.
 */
---

<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <symbol id="ic-bowl" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 46 h72 a2 2 0 0 1 2 2 c0 22-17 34-38 34 s-38-12-38-34 a2 2 0 0 1 2-2 Z"></path>
    <ellipse cx="50" cy="46" rx="36" ry="9"></ellipse>
  </symbol>
  <symbol id="ic-mug" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M22 30 h42 v34 a21 21 0 0 1-21 21 h0 a21 21 0 0 1-21-21 Z"></path>
    <path d="M64 40 h8 a12 12 0 0 1 0 24 h-8"></path>
  </symbol>
  <symbol id="ic-tray" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <rect x="12" y="34" width="76" height="34" rx="8"></rect>
    <path d="M20 68 l4 10 h52 l4-10"></path>
  </symbol>
  <symbol id="ic-vase" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M40 16 h20 l4 16 c10 10 12 22 8 34 c-4 12 2 18 2 18 a30 30 0 0 1-46 0 s6-6 2-18 c-4-12-2-24 8-34 Z"></path>
  </symbol>
  <symbol id="ic-candle" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <rect x="30" y="42" width="18" height="40" rx="3"></rect>
    <rect x="54" y="30" width="18" height="52" rx="3"></rect>
    <path d="M39 42 v-8 M63 30 v-8"></path>
    <circle cx="39" cy="30" r="3" fill="currentColor" stroke="none"></circle>
    <circle cx="63" cy="18" r="3" fill="currentColor" stroke="none"></circle>
  </symbol>
  <symbol id="ic-figure" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="50" cy="26" r="14"></circle>
    <path d="M50 40 c-18 0-26 12-26 30 c0 6 4 10 10 10 h32 c6 0 10-4 10-10 c0-18-8-30-26-30 Z"></path>
    <circle cx="42" cy="24" r="2.5" fill="currentColor" stroke="none"></circle>
    <circle cx="58" cy="24" r="2.5" fill="currentColor" stroke="none"></circle>
  </symbol>
  <symbol id="ic-wheel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="10.5" r="7.5"></circle>
    <circle cx="12" cy="10.5" r="2.4"></circle>
    <path d="M4 21h16"></path>
  </symbol>
  <symbol id="ic-sketch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 20l1.4-5L16 4.5 19.5 8 9 18.6 4 20Z"></path>
    <path d="M14.4 6.1l3.5 3.5"></path>
  </symbol>

  <symbol id="ic-tag" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M45 15 h30 a10 10 0 0 1 10 10 v30 a6 6 0 0 1-1.8 4.3 l-38 38 a6 6 0 0 1-8.5 0 l-23-23 a6 6 0 0 1 0-8.5 l38-38 A6 6 0 0 1 45 15 Z"></path>
    <circle cx="64" cy="36" r="6" fill="currentColor" stroke="none"></circle>
  </symbol>

  <symbol id="ic-instagram" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
    <circle cx="12" cy="12" r="4.2"></circle>
    <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"></circle>
  </symbol>
  <symbol id="ic-tiktok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 3.5c.6 2 2.1 3.4 4.2 3.7v3c-1.5.1-2.9-.3-4.2-1.1v6.4a5.3 5.3 0 1 1-5.3-5.3c.3 0 .6 0 .9.06v3.1a2.2 2.2 0 1 0 1.6 2.14V3.5Z"></path>
  </symbol>
  <symbol id="ic-youtube" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect>
    <path d="M10.5 9.2 15 12l-4.5 2.8Z" fill="currentColor" stroke="currentColor" stroke-linejoin="round"></path>
  </symbol>

  <symbol id="ic-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 7h16M4 12h16M4 17h16"></path>
  </symbol>
  <symbol id="ic-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 6l12 12M18 6 6 18"></path>
  </symbol>
  <symbol id="ic-arrow-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M15 5l-7 7 7 7"></path>
  </symbol>
  <symbol id="ic-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 5l7 7-7 7"></path>
  </symbol>
</svg>
