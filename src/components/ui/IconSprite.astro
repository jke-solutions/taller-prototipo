    <circle cx="58" cy="24" r="2.5" fill="currentColor" stroke="none"></circle>
  </symbol>
  <symbol id="ic-wheel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="10.5" r="7.5"></circle>
    <circle cx="12" cy="10.5" r="2.4"></circle>
    <path d="M4 21h16"></path>
  </symbol>
  <symbol id="ic-sketch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 20l1.4-5L16 4.5 19.5 8 9 18.6 4 20Z"></path>
    <path d="M14.4 6.1l3.5 3.5"></path>
  </symbol>

  <symbol id="ic-tag" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
