    <path d="M12 7v5l3.5 2"></path>
  </symbol>
  <symbol id="ic-map-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z"></path>
    <circle cx="12" cy="9.5" r="2.4"></circle>
  </symbol>
  <symbol id="ic-calendar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3.5" y="5" width="17" height="15" rx="2"></rect>
    <path d="M3.5 9.5h17"></path>
    <path d="M8 3v4M16 3v4"></path>
  </symbol>
  <symbol id="ic-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="9" cy="8.5" r="3"></circle>
    <path d="M3.5 19c0-3.3 2.5-5.5 5.5-5.5s5.5 2.2 5.5 5.5"></path>
    <circle cx="17" cy="9.5" r="2.4"></circle>
    <path d="M15.5 13.6c2 .4 3.5 2 3.5 4.4"></path>
  </symbol>
</svg>
