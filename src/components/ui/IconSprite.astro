---
/**
 * Sprite SVG inline. Se incluye UNA sola vez en el layout base; los
 * componentes referencian cada ícono con <use href="#ic-{name}"> vía <Icon />.
 */
---

<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <symbol id="ic-bowl" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 46 h72 a2 2 0 0 1 2 2 c0 22-17 34-38 34 s-38-12-38-34 a2 2 0 0 1 2-2 Z"></path>
    <ellipse cx="50" cy="46" rx="36" ry="9"></ellipse>
  </symbol>
  <symbol id="ic-mug" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M22 30 h42 v34 a21 21 0 0 1-21 21 h0 a21 21 0 0 1-21-21 Z"></path>
    <path d="M64 40 h8 a12 12 0 0 1 0 24 h-8"></path>
  </symbol>
  <symbol id="ic-tray" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <rect x="12" y="34" width="76" height="34" rx="8"></rect>
