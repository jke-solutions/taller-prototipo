  </symbol>
  <symbol id="ic-cart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M2.5 3.5h2.6l1 4M6.1 7.5l1.7 8a1.6 1.6 0 0 0 1.6 1.3h7.5a1.6 1.6 0 0 0 1.58-1.36l1.02-6.44a1 1 0 0 0-1-1.16H6.1Z"></path>
    <circle cx="10" cy="20.2" r="1.4"></circle>
    <circle cx="17" cy="20.2" r="1.4"></circle>
  </symbol>
  <symbol id="ic-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="4" y="10" width="16" height="10" rx="2"></rect>
    <path d="M7.5 10V7a4.5 4.5 0 0 1 9 0v3"></path>
  </symbol>
  <symbol id="ic-truck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
