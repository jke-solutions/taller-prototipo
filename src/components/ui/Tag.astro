---
/**
 * Tag / badge de producto (brief → radios: 4px; font 13px/700).
 * Los tintes salen del color de marca vía color-mix(), igual que el
 * prototipo de referencia.
 */
type Variant = 'ceramica' | 'madera' | 'edicion' | 'promo';

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = 'ceramica', class: className } = Astro.props;

// [color base de marca] por variante
const baseColor: Record<Variant, string> = {
  ceramica: 'var(--forest)',
  madera: 'var(--primary)',
  edicion: 'var(--teal)',
  promo: 'var(--coral)',
};

const c = baseColor[variant];
const style = `background:color-mix(in oklch, ${c} 16%, white); color:color-mix(in oklch, ${c} 70%, black);`;
---

<span
  class:list={[
    'inline-block font-body font-bold text-[13px] px-[14px] py-[6px] rounded-tag',
    className,
  ]}
  style={style}
>
  <slot />
</span>
