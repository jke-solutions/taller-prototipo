---
/**
 * Header del sitio — se repite en todas las páginas vía BaseLayout.
 * Sticky siempre (position: sticky) con sombra sutil solo cuando hay scroll.
 * Fondo blanco, borde inferior fino. Logo a la izquierda, nav al centro-derecha,
 * botón "Carrito (0)" a la derecha. Bajo 768px el nav se oculta y aparece el
 * botón de menú: un panel liviano que se despliega DEBAJO del header (sin
 * overlay ni blur), se cierra al tocar un link, Escape o fuera del header.
 */
import Icon from '@components/ui/Icon.astro';
import { mainNav } from '@data/nav';
import { site } from '@data/site';

interface Props {
  /** Ruta actual, para marcar el link activo del nav. */
  pathname?: string;
}

const { pathname = '' } = Astro.props;
const isActive = (href: string) =>
  href !== '/' && (pathname === href || pathname.startsWith(href + '/'));
---

<header
  class="sticky top-0 z-40 bg-white border-b border-border transition-shadow duration-200"
  data-header
>
  <div class="wrap flex items-center justify-between py-4 md:py-5">
    <a href="/" class="flex items-center gap-[12px]" aria-label={`${site.name} — inicio`}>
      <img src="/felipe-logo.svg" alt="" width="40" height="43" class="w-9 md:w-10 h-auto" />
      <span class="font-display font-extrabold text-[19px] md:text-[20px] text-ink tracking-[-0.01em]">
        {site.name}
      </span>
    </a>

    <nav class="hidden md:flex gap-[30px] font-bold text-[13px]" aria-label="Navegación principal">
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-ink transition-opacity hover:opacity-100',
              isActive(item.href) ? 'opacity-100' : 'opacity-[0.65]',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-[6px]">
      <button
        type="button"
        class="relative w-10 h-10 flex items-center justify-center text-ink"
        aria-label="Abrir carrito"
        data-cart-open
      >
        <Icon name="cart" size={22} />
        <span
          class="absolute top-1 right-1 min-w-[16px] h-4 px-[3px] rounded-full bg-maroon text-white text-[10px] font-bold leading-4 text-center"
          data-cart-count
        >0</span>
      </button>
      <button
        type="button"
        class="md:hidden flex items-center justify-center w-9 h-9 border border-ink rounded-[2px] text-ink"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span data-icon-open><Icon name="menu" size={20} /></span>
        <span data-icon-close hidden><Icon name="close" size={20} /></span>
      </button>
    </div>
  </div>

  {/* Panel mobile — se despliega bajo el header. Cerrado: max-height 0 + inert. */}
  <div
    id="mobile-menu"
    class="md:hidden absolute inset-x-0 top-full bg-white border-b border-border overflow-hidden transition-[max-height,opacity] duration-200 ease-out motion-reduce:transition-none"
    style="max-height:0;opacity:0;"
    data-menu-panel
    inert
  >
    <nav class="wrap flex flex-col pb-4" aria-label="Navegación principal">
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class="py-4 font-bold text-[17px] text-ink border-b border-border"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <button type="button" class="py-4 font-bold text-[17px] text-maroon text-left" data-cart-open>
        Carrito (<span data-cart-count>0</span>)
      </button>
    </nav>
  </div>
</header>

<script>
  import { initCartCount } from '@/scripts/cart';
  initCartCount();
</script>

<script>
  // Header sticky + menú mobile: JS vanilla mínimo, sin librerías.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const iconOpen = toggle?.querySelector<HTMLElement>('[data-icon-open]');
  const iconClose = toggle?.querySelector<HTMLElement>('[data-icon-close]');
  const mdUp = window.matchMedia('(min-width: 768px)');

  let open = false;

  const setOpen = (next: boolean) => {
    if (!panel || !toggle) return;
    open = next;
    panel.style.maxHeight = open ? '70vh' : '0';
    panel.style.opacity = open ? '1' : '0';
    panel.toggleAttribute('inert', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    if (iconOpen) iconOpen.hidden = open;
    if (iconClose) iconClose.hidden = !open;
  };

  toggle?.addEventListener('click', () => setOpen(!open));
  panel?.querySelectorAll('a, button').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) {
      setOpen(false);
      toggle?.focus();
    }
  });
  // Tocar fuera del header cierra el panel.
  document.addEventListener('pointerdown', (e) => {
    if (open && !(e.target as Element).closest('[data-header]')) setOpen(false);
  });
  // Si se agranda la ventana al breakpoint desktop, el panel se cierra solo.
  mdUp.addEventListener('change', (e) => e.matches && setOpen(false));

  // Sombra sutil solo cuando hay scroll (un solo listener, con rAF).
  let raf = 0;
  const updateShadow = () => {
    raf = 0;
    header?.classList.toggle('is-scrolled', window.scrollY > 4);
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!raf) raf = requestAnimationFrame(updateShadow);
    },
    { passive: true }
  );
  updateShadow();
</script>

<style>
  [data-header].is-scrolled {
    box-shadow: 0 2px 12px rgba(100, 27, 11, 0.08);
  }
</style>
