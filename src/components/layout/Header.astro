---
/**
 * Header del sitio — se repite en todas las páginas vía BaseLayout.
 * Fondo blanco, borde inferior fino. Logo a la izquierda, nav al centro-derecha,
 * botón "Carrito (0)" a la derecha. Bajo 768px el nav se oculta y aparece el
 * botón de menú (drawer con JS vanilla mínimo).
 */
import Icon from '@components/ui/Icon.astro';
import { mainNav } from '@data/nav';
import { site } from '@data/site';

interface Props {
  /** Ruta actual, para marcar el link activo del nav. */
  pathname?: string;
}

const { pathname = '' } = Astro.props;
const isActive = (href: string) =>
  href !== '/' && (pathname === href || pathname.startsWith(href + '/'));
---

<header class="bg-white border-b border-border">
  <div class="wrap flex items-center justify-between py-6">
    <a href="/" class="flex items-center gap-[12px]" aria-label={`${site.name} — inicio`}>
      <img src="/felipe-logo.svg" alt="" width="40" height="43" class="w-10 h-auto" />
      <span class="font-display font-extrabold text-[20px] text-ink tracking-[-0.01em]">
        {site.name}
      </span>
    </a>

    <nav class="hidden md:flex gap-[30px] font-bold text-[13px]" aria-label="Navegación principal">
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-ink transition-opacity hover:opacity-100',
              isActive(item.href) ? 'opacity-100' : 'opacity-[0.65]',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-[12px]">
      <a
        href="/carrito"
        class="border border-ink text-ink px-4 py-2 rounded-[2px] font-bold text-[13px] leading-none whitespace-nowrap"
      >
        Carrito (0)
      </a>
      <button
        type="button"
        class="md:hidden flex items-center justify-center w-9 h-9 border border-ink rounded-[2px] text-ink"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

  {/* Drawer mobile — oculto por defecto, se muestra al tocar el botón. */}
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 hidden md:hidden"
    data-menu-panel
  >
    <div class="absolute inset-0 bg-black/40" data-menu-close></div>
    <nav
      class="absolute right-0 top-0 h-full w-[78%] max-w-[320px] bg-white shadow-xl flex flex-col p-8 gap-2"
      aria-label="Navegación principal"
    >
      <button
        type="button"
        class="self-end flex items-center justify-center w-9 h-9 border border-ink rounded-[2px] text-ink mb-2"
        aria-label="Cerrar menú"
        data-menu-close
      >
        <Icon name="close" size={20} />
      </button>
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class="py-2 font-bold text-[15px] text-ink border-b border-border"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/carrito" class="py-2 font-bold text-[15px] text-maroon">Carrito (0)</a>
    </nav>
  </div>
</header>

<script>
  // Menú mobile: JS vanilla mínimo, sin librerías.
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closers = document.querySelectorAll<HTMLElement>('[data-menu-close]');

  const setOpen = (open: boolean) => {
    if (!panel || !openBtn) return;
    panel.classList.toggle('hidden', !open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  openBtn?.addEventListener('click', () => setOpen(true));
  closers.forEach((el) => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
