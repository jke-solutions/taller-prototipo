---
/**
 * Panel del carrito: se abre al tocar el ícono del carrito en el Header
 * (desktop y mobile), desliza desde la derecha sobre un overlay. Vive una
 * sola vez en BaseLayout (como el IconSprite) porque el trigger está en
 * todas las páginas.
 *
 * El contenido depende de localStorage (ver src/scripts/cart.ts) así que se
 * pinta en el cliente, igual que /carrito — este panel es el atajo rápido;
 * /carrito sigue siendo la vista completa ("Ver carrito" lleva ahí).
 */
import Icon from '@components/ui/Icon.astro';
import Button from '@components/ui/Button.astro';
---

<div class="fixed inset-0 z-50 hidden" data-cart-drawer>
  <div class="absolute inset-0 bg-[rgba(100,27,11,0.28)] opacity-0 transition-opacity duration-300" data-cart-drawer-backdrop></div>

  <div
    class="absolute inset-y-0 right-0 w-full max-w-[420px] bg-white flex flex-col translate-x-full transition-transform duration-300 ease-out shadow-[-24px_0_48px_rgba(100,27,11,0.16)]"
    data-cart-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-drawer-title"
  >
    <div class="flex items-center justify-between px-6 py-5 border-b border-border shrink-0">
      <h2 id="cart-drawer-title" class="font-display text-[18px] text-ink">
        Tu carrito <span class="text-maroon" data-cart-drawer-count>0</span> <span data-cart-drawer-label>artículos</span>
      </h2>
      <button type="button" class="text-muted shrink-0" aria-label="Cerrar carrito" data-cart-drawer-close>
        <Icon name="close" size={20} />
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-6" data-cart-drawer-body>
      <div class="hidden flex-col items-center justify-center h-full text-center gap-4 py-16" data-cart-drawer-empty>
        <span class="text-border"><Icon name="cart" size={40} /></span>
        <p class="text-[15px] text-muted">Tu carrito está vacío.</p>
        <Button href="/catalogo" variant="secondary" size="sm" data-cart-drawer-close>
          Ir al catálogo
        </Button>
      </div>
      <div class="flex flex-col divide-y divide-border" data-cart-drawer-items></div>
    </div>

    <div class="border-t border-border px-6 py-5 flex flex-col gap-3 shrink-0" data-cart-drawer-footer hidden>
      <div class="flex items-center justify-between text-[15px]">
        <span class="text-muted">Subtotal</span>
        <span class="font-display text-[20px] text-maroon" data-cart-drawer-subtotal>S/ 0.00</span>
      </div>
      <Button href="/carrito" variant="secondary" size="lg">
        <span>Ver carrito</span>
      </Button>
      <Button variant="primary" size="lg" data-cart-drawer-pay>Pagar pedido</Button>
    </div>
  </div>
</div>

<template data-cart-drawer-row-template>
  <div class="flex gap-3 py-5">
    <div class="relative w-[64px] h-[64px] shrink-0 rounded-card flex items-center justify-center" data-row-thumb>
      <svg width="22" height="22" data-row-icon><use></use></svg>
      <button
        type="button"
        class="absolute -top-2 -left-2 w-5 h-5 rounded-full bg-maroon text-white flex items-center justify-center"
        aria-label="Quitar del carrito"
        data-row-remove
      >
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
    <div class="flex-1 min-w-0">
      <div class="font-bold text-[14.5px] text-ink truncate" data-row-name></div>
      <div class="flex items-center justify-between mt-1">
        <div class="inline-flex items-center border border-border rounded-[2px]">
          <button type="button" class="w-7 h-7 flex items-center justify-center text-ink text-[13px]" aria-label="Reducir cantidad" data-row-decrease>−</button>
          <span class="w-6 text-center text-[13px]" data-row-qty></span>
          <button type="button" class="w-7 h-7 flex items-center justify-center text-ink text-[13px]" aria-label="Aumentar cantidad" data-row-increase>+</button>
        </div>
        <span class="font-bold text-[14px] text-maroon" data-row-price></span>
      </div>
    </div>
  </div>
</template>

<script>
  import { getCart, updateCartQty, removeFromCart, parsePrice, brandColorVar, type CartItem } from '@/scripts/cart';

  const drawer = document.querySelector<HTMLElement>('[data-cart-drawer]');
  const panel = drawer?.querySelector<HTMLElement>('[data-cart-drawer-panel]');
  const backdrop = drawer?.querySelector<HTMLElement>('[data-cart-drawer-backdrop]');
  const itemsEl = drawer?.querySelector<HTMLElement>('[data-cart-drawer-items]');
  const emptyEl = drawer?.querySelector<HTMLElement>('[data-cart-drawer-empty]');
  const footerEl = drawer?.querySelector<HTMLElement>('[data-cart-drawer-footer]');
  const countEl = drawer?.querySelector<HTMLElement>('[data-cart-drawer-count]');
  const labelEl = drawer?.querySelector<HTMLElement>('[data-cart-drawer-label]');
  const subtotalEl = drawer?.querySelector<HTMLElement>('[data-cart-drawer-subtotal]');
  const payBtn = drawer?.querySelector<HTMLButtonElement>('[data-cart-drawer-pay]');
  const rowTemplate = document.querySelector<HTMLTemplateElement>('[data-cart-drawer-row-template]');

  function render() {
    if (!itemsEl || !emptyEl || !footerEl || !countEl || !labelEl || !subtotalEl || !rowTemplate) return;
    const cart = getCart();
    const count = cart.reduce((sum, i) => sum + i.qty, 0);

    countEl.textContent = String(count);
    labelEl.textContent = count === 1 ? 'artículo' : 'artículos';
    emptyEl.classList.toggle('hidden', cart.length > 0);
    emptyEl.classList.toggle('flex', cart.length === 0);
    footerEl.hidden = cart.length === 0;

    itemsEl.innerHTML = '';
    let subtotal = 0;

    cart.forEach((item: CartItem) => {
      subtotal += parsePrice(item.price) * item.qty;

      const row = rowTemplate.content.cloneNode(true) as DocumentFragment;
      const thumb = row.querySelector<HTMLElement>('[data-row-thumb]');
      const svg = row.querySelector<SVGElement>('[data-row-icon]');
      const use = row.querySelector<SVGUseElement>('[data-row-icon] use');
      if (thumb) thumb.style.background = brandColorVar[item.color] ? `color-mix(in oklch, ${brandColorVar[item.color]} 16%, white)` : 'var(--cream)';
      if (svg) svg.style.color = brandColorVar[item.color] ?? 'var(--muted)';
      if (use) use.setAttribute('href', `#ic-${item.icon}`);

      const nameEl = row.querySelector<HTMLElement>('[data-row-name]');
      if (nameEl) nameEl.textContent = item.name;
      const priceEl = row.querySelector<HTMLElement>('[data-row-price]');
      if (priceEl) priceEl.textContent = item.price;
      const qtyEl = row.querySelector<HTMLElement>('[data-row-qty]');
      if (qtyEl) qtyEl.textContent = String(item.qty);

      row.querySelector('[data-row-decrease]')?.addEventListener('click', () => {
        if (item.qty <= 1) return;
        updateCartQty(item.slug, item.qty - 1);
        render();
      });
      row.querySelector('[data-row-increase]')?.addEventListener('click', () => {
        updateCartQty(item.slug, item.qty + 1);
        render();
      });
      row.querySelector('[data-row-remove]')?.addEventListener('click', () => {
        removeFromCart(item.slug);
        render();
      });

      itemsEl.appendChild(row);
    });

    subtotalEl.textContent = `S/ ${subtotal.toFixed(2)}`;
  }

  function openDrawer() {
    if (!drawer || !panel || !backdrop) return;
    render();
    drawer.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      backdrop.classList.remove('opacity-0');
      panel.classList.remove('translate-x-full');
    });
  }

  function closeDrawer() {
    if (!drawer || !panel || !backdrop) return;
    backdrop.classList.add('opacity-0');
    panel.classList.add('translate-x-full');
    document.body.style.overflow = '';
    window.setTimeout(() => drawer.classList.add('hidden'), 300);
  }

  document.querySelectorAll('[data-cart-open]').forEach((btn) => btn.addEventListener('click', openDrawer));
  drawer?.querySelectorAll('[data-cart-drawer-close]').forEach((btn) => btn.addEventListener('click', closeDrawer));
  backdrop?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) closeDrawer();
  });

  payBtn?.addEventListener('click', () => {
    if (getCart().length === 0) return;
    window.location.href = '/checkout';
  });

  window.addEventListener('cart:updated', () => {
    if (drawer && !drawer.classList.contains('hidden')) render();
  });
</script>
