---
/**
 * Un slide del slider de productos destacados.
 * Tarjeta con borde fino: placeholder cuadrado a la izquierda, info a la
 * derecha (nombre, tags, descripción, precio, botón). Bajo 768px se apila.
 * Ref. visual: .e-featured .grid de la variante F.
 */
import Button from '@components/ui/Button.astro';
import Tag from '@components/ui/Tag.astro';
import Placeholder from '@components/ui/Placeholder.astro';
import type { FeaturedProduct } from '@data/featuredProducts';

interface Props {
  product: FeaturedProduct;
}

const { product } = Astro.props;
---

<article
  class="grid md:grid-cols-2 gap-7 md:gap-16 items-center border border-border rounded-card bg-white p-8 md:p-16"
  data-reveal
>
  <div data-reveal-child style="--i:0;">
    <Placeholder
      icon={product.icon}
      label={`Foto de ${product.name}`}
      color={product.color}
      ratio="1 / 1"
      iconScale={26}
      image={product.image}
    />
  </div>

  <div data-reveal-child style="--i:1;">
    <h3 class="font-display text-[34px] md:text-[30px] text-ink mb-[14px]">{product.name}</h3>
    <div class="flex flex-wrap gap-2 mb-5">
      {product.tags.map((t) => <Tag variant={t.variant}>{t.label}</Tag>)}
    </div>
    <p class="font-body text-[16px] text-muted leading-[1.8] mb-6">{product.description}</p>
    <div class="font-display text-[26px] text-maroon mb-[22px]">{product.price}</div>
    <Button href={product.href} variant="primary">Ver producto</Button>
  </div>
</article>
