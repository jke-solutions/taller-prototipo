---
/**
 * Hero del Home — dos columnas: texto a la izquierda, imagen a la derecha.
 * Bajo 860px colapsa a una sola columna apilada.
 *
 * Provisional: será reemplazado por el slider tipo revista al final.
 * Ref. visual: variante F del prototipo (.f-hero).
 */
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { hero as heroDefault, type HeroContent } from '@data/hero';

interface Props {
  content?: HeroContent;
}

const { content = heroDefault } = Astro.props;
---

<section class="bg-white">
  <div class="grid lg:grid-cols-2 lg:min-h-[76vh]">
    <div class="flex flex-col justify-center px-7 py-14 lg:px-16 lg:py-[60px]">
      <div class="accent-rule mb-[22px]"></div>
      <h1
        class="font-display font-extrabold text-ink tracking-[-0.01em] mb-[18px]"
        style="font-size:min(5.5vw, 46px);"
      >
        {content.title}
      </h1>
      <p class="font-body text-[15.5px] text-muted leading-[1.75] mb-[26px] max-w-[440px]">
        {content.body}
      </p>
      <div class="flex flex-wrap gap-[14px]">
        {
          content.ctas.map((cta) => (
            <Button href={cta.href} variant={cta.variant}>
              {cta.label}
            </Button>
          ))
        }
      </div>
    </div>

    <div
      class="relative flex items-center justify-center bg-cream border-t border-border lg:border-t-0 lg:border-l min-h-[340px]"
      role="img"
      aria-label={`Espacio para ${content.image.label.toLowerCase()}`}
    >
      <div class="w-[24%] text-muted">
        <Icon name={content.image.icon} size={0} class="w-full h-auto" />
      </div>
      <span
        class="absolute bottom-5 left-1/2 -translate-x-1/2 font-body text-[11px] font-bold uppercase tracking-[0.05em] text-muted"
      >
        {content.image.label}
      </span>
    </div>
  </div>
</section>
