---
/**
 * "En promoción" — rótulo + link "Ver todas" (solo si hay más promos en el CMS
 * que las listadas) + tarjetas que llenan el 100% del ancho.
 *
 * Desktop (>=768px): grid de 5 columnas. Mobile (<768px): slider horizontal
 * automático (scroll-snap + autoplay) con puntos de paginación.
 * Ref. visual: bloque promo de la variante F.
 */
import Icon from '@components/ui/Icon.astro';
import PromoCard from './PromoCard.astro';
import { promos as defaultPromos, totalPromoCount, type PromoProduct } from '@data/promos';

interface Props {
  eyebrow?: string;
  products?: PromoProduct[];
  /** Total real de promos (para decidir si se muestra "Ver todas"). */
  total?: number;
  seeAllHref?: string;
}

const {
  eyebrow = 'En promoción',
  products = defaultPromos,
  total = totalPromoCount,
  seeAllHref = '/catalogo/promociones',
} = Astro.props;

const showSeeAll = total > products.length;
---

<section class="bg-white pb-18">
  <div class="bg-white pt-18 pb-6">
    <div class="wrap">
      <div class="flex items-center justify-between">
        <p class="section-eyebrow">{eyebrow}</p>
        {
          showSeeAll && (
            <a
              href={seeAllHref}
              class="flex items-center gap-1 font-body text-[13px] font-bold text-ink underline underline-offset-[3px]"
            >
              Ver todas
              <Icon name="arrow-right" size={14} />
            </a>
          )
        }
      </div>
      <div class="accent-rule mt-[14px]"></div>
    </div>
  </div>

  <div data-rcarousel data-bp="768" data-interval="5000">
    <div
      class="no-scrollbar flex w-full snap-x snap-mandatory gap-4 overflow-x-auto border-t border-border px-5 pb-4 md:grid md:grid-cols-5 md:gap-0 md:overflow-visible md:px-0 md:pb-0"
      data-track
    >
      {
        products.map((product) => (
          <div class="shrink-0 basis-[72%] snap-start md:contents" data-slide>
            <PromoCard product={product} />
          </div>
        ))
      }
    </div>

    <div class="mt-4 flex justify-center gap-2 md:hidden" data-dots>
      {
        products.map((_, i) => (
          <button
            type="button"
            class="h-[7px] rounded-full bg-border transition-all data-[active]:bg-maroon"
            style="width:7px;"
            aria-label={`Ir a la promoción ${i + 1}`}
            data-dot
            data-index={i}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initAllResponsiveCarousels } from '@/scripts/responsiveCarousel';
  initAllResponsiveCarousels();
</script>
