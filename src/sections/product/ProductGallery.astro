---
/**
 * Galería de producto: foto grande arriba, miniaturas EN UNA FILA DEBAJO
 * (no al costado — pedido explícito del cliente, a diferencia del layout de
 * referencia que las ponía a la izquierda). Clic en una miniatura cambia
 * cuál foto se ve arriba. Sin fotos reales todavía, cada slot cae al
 * Placeholder de marca (mismo patrón que el resto del sitio).
 *
 * "En promoción" (product.discountPercent) NO es un tag — un tag es
 * material/subcategoría (Cerámica, Madera, Edición limitada). Va como
 * bandera "-X%" sobre la foto, misma esquina y estilo que el badge de
 * PromoCard.astro en el Home, para que se lea como el mismo concepto en
 * los dos lugares.
 */
import Placeholder from '@components/ui/Placeholder.astro';
import Icon from '@components/ui/Icon.astro';
import type { Product } from '@data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div data-gallery>
  <div class="relative mb-4">
    {
      product.discountPercent && (
        <span class="absolute top-[10px] left-[10px] z-10 bg-maroon text-white text-[12px] font-extrabold px-[9px] py-1 rounded-[3px]">
          -{product.discountPercent}%
        </span>
      )
    }
    {
      product.gallery.map((item, i) => (
        <div data-gallery-slide data-index={i} class:list={[i !== 0 && 'hidden']}>
          {item.image ? (
            <button
              type="button"
              class="group relative block w-full text-left cursor-zoom-in"
              data-gallery-zoom-trigger
              data-src={item.image.src}
              data-alt={item.image.alt}
              aria-label={`Ver imagen más grande: ${item.image.alt}`}
            >
              <Placeholder
                icon={product.icon}
                color={product.color}
                label={item.label}
                image={item.image}
                ratio="1 / 1"
                iconScale={26}
              />
              <span class="absolute bottom-[10px] left-1/2 -translate-x-1/2 flex items-center gap-[6px] whitespace-nowrap rounded-full bg-white/95 px-3 py-[7px] font-body text-[12.5px] font-bold text-ink shadow-[0_4px_10px_rgba(0,0,0,0.14)] opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100">
                <Icon name="search" size={14} />
                Haz clic para agrandar
              </span>
            </button>
          ) : (
            <Placeholder
              icon={product.icon}
              color={product.color}
              label={item.label}
              image={item.image}
              ratio="1 / 1"
              iconScale={26}
            />
          )}
        </div>
      ))
    }
  </div>

  {
    product.gallery.length > 1 && (
      <div class="flex gap-3 overflow-x-auto no-scrollbar" role="tablist" aria-label="Fotos del producto">
        {product.gallery.map((item, i) => (
          <button
            type="button"
            role="tab"
            aria-selected={i === 0}
            aria-controls={`gallery-slide-${i}`}
            data-gallery-thumb
            data-index={i}
            class:list={[
              'shrink-0 w-20 h-20 rounded-card overflow-hidden border-2 transition-colors',
              i === 0 ? 'border-maroon' : 'border-transparent',
            ]}
          >
            <Placeholder
              icon={product.icon}
              color={product.color}
              label={item.label}
              image={item.image}
              ratio="1 / 1"
              iconScale={34}
              class="rounded-none"
            />
          </button>
        ))}
      </div>
    )
  }

  <div
    class="fixed inset-0 z-50 hidden items-center justify-center bg-[rgba(20,10,8,0.85)] p-4"
    data-gallery-modal
    role="dialog"
    aria-modal="true"
    aria-label={`Foto ampliada de ${product.name}`}
    hidden
  >
    <button
      type="button"
      class="absolute top-4 right-4 md:top-6 md:right-6 text-white"
      aria-label="Cerrar"
      data-gallery-modal-close
    >
      <Icon name="close" size={26} />
    </button>
    <img data-gallery-modal-image src="" alt="" class="max-h-[90vh] max-w-[90vw] w-auto h-auto rounded-card object-contain" />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]')];
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')];

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = thumb.dataset.index;
        slides.forEach((slide) => slide.classList.toggle('hidden', slide.dataset.index !== index));
        thumbs.forEach((t) => {
          const active = t === thumb;
          t.setAttribute('aria-selected', String(active));
          t.classList.toggle('border-maroon', active);
          t.classList.toggle('border-transparent', !active);
        });
      });
    });

    const modal = gallery.querySelector<HTMLElement>('[data-gallery-modal]');
    const modalImage = modal?.querySelector<HTMLImageElement>('[data-gallery-modal-image]');
    const zoomTriggers = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-zoom-trigger]')];

    const closeModal = () => {
      if (!modal) return;
      modal.hidden = true;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
    };

    zoomTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        if (!modal || !modalImage) return;
        modalImage.src = trigger.dataset.src ?? '';
        modalImage.alt = trigger.dataset.alt ?? '';
        modal.hidden = false;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.classList.add('overflow-hidden');
      });
    });

    modal?.querySelectorAll<HTMLElement>('[data-gallery-modal-close]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
    });
  });
</script>
