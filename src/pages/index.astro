---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSlider from '@sections/home/HeroSlider.astro';
import CategoryGrid from '@sections/home/CategoryGrid.astro';
import FeaturedProducts from '@sections/home/FeaturedProducts.astro';
import ServicesSection from '@sections/home/ServicesSection.astro';
import PromoGrid from '@sections/home/PromoGrid.astro';
import StorySection from '@sections/home/StorySection.astro';
---

<BaseLayout title="Inicio" snapScroll>
  {/*
    Orden del Home (a pedido del cliente):
    1. Slider tipo revista
    2. Producto destacado (slider de varios)
    3. En promoción
    4. Explora por categoría
    5. Servicios (Cursos y Talleres / Trabajos Personalizados)
    6. Conoce el taller
  */}
  <HeroSlider />
  <FeaturedProducts />
  <PromoGrid />
  <CategoryGrid />
  <ServicesSection />
  <StorySection />
</BaseLayout>
