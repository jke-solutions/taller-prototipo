---
/**
 * Página de Contacto. Formulario solo visual (sin backend en el prototipo,
 * ver script al final — mismo patrón que el newsletter del Footer). El
 * panel de canales (WhatsApp/Instagram/Web) sale de src/data/site.ts.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import FormField from '@components/ui/FormField.astro';
import FormSelect from '@components/ui/FormSelect.astro';
import FormTextarea from '@components/ui/FormTextarea.astro';
import isotipoFelipe from '@assets/isotipo-felipe.svg';
import { site } from '@data/site';

const motivos = [
  'Pedido personalizado',
  'Consulta sobre un producto',
  'Talleres y experiencias',
  'Colaboraciones',
  'Otro',
];
---

<BaseLayout
  title="Contacto"
  description="Escríbenos para consultas sobre productos, pedidos personalizados, talleres y colaboraciones. También puedes encontrarnos en nuestras redes sociales."
>
  <div class="bg-cream">
    <!-- Hero -->
    <header class="max-w-[760px] mx-auto px-8 sm:px-8 pt-14 md:pt-16">
      <p class="section-eyebrow">Contacto</p>

      <h1 class="font-display text-[38px] md:text-[52px] text-ink mt-[22px] tracking-[-0.01em]">
        Hablemos
      </h1>

      <p class="font-body text-[17px] md:text-[19px] leading-[1.6] text-muted mt-5 max-w-[600px]">
        ¿Tienes una idea, un pedido especial o solo quieres saber más de nuestro trabajo? Nos
        encantará leerte.
      </p>
    </header>

    <!-- Panel + formulario -->
    <div class="max-w-[1000px] mx-auto px-8 pt-12 pb-20 md:pb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-7 items-stretch">
        <!-- Panel de canales -->
        <div class="contact-panel relative overflow-hidden bg-maroon p-9 md:p-10 flex flex-col justify-between" style="color: var(--cream); border-radius: 10px;">
          <svg
            viewBox="0 0 200 200"
            class="absolute -right-12 -top-12"
            style="width: 220px; height: 220px; opacity: 0.16;"
            aria-hidden="true"
          >
            <circle cx="100" cy="100" r="94" fill="none" stroke="var(--cream)" stroke-width="1.5"></circle>
            <circle cx="100" cy="100" r="66" fill="none" stroke="var(--cream)" stroke-width="1.5"></circle>
            <circle cx="100" cy="100" r="38" fill="none" stroke="var(--cream)" stroke-width="1.5"></circle>
          </svg>
          <svg
            viewBox="0 0 160 160"
            class="absolute -left-8 -bottom-8"
            style="width: 150px; height: 150px; opacity: 0.14;"
            aria-hidden="true"
          >
            <path
              d="M10 130 C 40 40, 120 40, 150 130"
              fill="none"
              stroke="var(--cream)"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>

          <div class="relative">
            <img src={isotipoFelipe.src} alt="" width="46" height="49" class="mb-6" />

            <h2 class="font-display text-[22px] md:text-[24px] mb-4" style="color: var(--cream);">Escríbenos</h2>
            <p class="font-body text-[15.5px] leading-[1.75] max-w-[340px] opacity-90">
              Para consultas sobre productos, pedidos personalizados, talleres y colaboraciones.
            </p>
            <p class="font-body text-[15.5px] leading-[1.75] max-w-[340px] opacity-90" style="margin-top: 14px;">
              También puedes encontrarnos y seguir nuestro trabajo en nuestras redes sociales.
            </p>
          </div>

          <div class="channel-list relative" style="border-top: 1px solid rgba(251,242,225,0.22);">
            <a href={site.whatsappHref} target="_blank" rel="noopener" class="channel-link">
              <span class="channel-ring flex-none rounded-full flex items-center justify-center transition-colors">
                <Icon name="whatsapp" size={18} />
              </span>
              <span class="channel-text">
                <span class="block text-[11.5px] font-bold uppercase tracking-[0.07em] opacity-75">WhatsApp</span>
                <span class="block text-[15px] font-bold">{site.whatsappNumber}</span>
              </span>
            </a>

            <a
              href={`https://instagram.com/${site.instagramHandle.replace('@', '')}`}
              target="_blank"
              rel="noopener"
              class="channel-link"
            >
              <span class="channel-ring flex-none rounded-full flex items-center justify-center transition-colors">
                <Icon name="instagram" size={17} />
              </span>
              <span class="channel-text">
                <span class="block text-[11.5px] font-bold uppercase tracking-[0.07em] opacity-75">Instagram</span>
                <span class="block text-[15px] font-bold">{site.instagramHandle}</span>
              </span>
            </a>

            <a href={site.websiteHref} target="_blank" rel="noopener" class="channel-link">
              <span class="channel-ring flex-none rounded-full flex items-center justify-center transition-colors">
                <Icon name="web" size={18} />
              </span>
              <span class="channel-text">
                <span class="block text-[11.5px] font-bold uppercase tracking-[0.07em] opacity-75">Web</span>
                <span class="block text-[15px] font-bold">{site.websiteLabel}</span>
              </span>
            </a>
          </div>
        </div>

        <!-- Formulario -->
        <form data-contact-form class="bg-white border border-border p-9 md:p-10 flex flex-col gap-5" style="border-radius: 10px;">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <FormField label="Nombre" name="nombre" required autocomplete="name" />
            <FormField label="WhatsApp" name="telefono" type="tel" autocomplete="tel" />
          </div>

          <FormField label="Correo electrónico" name="correo" type="email" required autocomplete="email" />

          <FormSelect label="Motivo de tu mensaje" name="asunto" required>
            {motivos.map((m) => <option>{m}</option>)}
          </FormSelect>

          <FormTextarea label="Mensaje" name="mensaje" required rows={5} />

          <label class="flex items-start gap-[10px] text-[13.5px] text-muted leading-[1.6]">
            <input type="checkbox" name="acepto" required class="mt-[3px]" />
            Acepto la <a href="/politica-de-privacidad" class="text-ink underline underline-offset-[3px]">Política de Privacidad</a> de Taller Azotea.
          </label>

          <div>
            <Button type="submit" variant="primary">Enviar mensaje</Button>
          </div>

          <p class="text-[12.5px] text-muted -mt-2 hidden" data-contact-form-ok>
            ¡Gracias por escribirnos! (demo — todavía sin backend)
          </p>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /*
   * Panel de canales (fondo maroon + texto/bordes cream): el espaciado y
   * los colores de este bloque van en CSS plano (no clases de Tailwind)
   * porque son valores que no se usaban antes en el resto del sitio
   * (gaps fraccionarios, "cream" como color de texto/borde) y el dev
   * server no los estaba compilando — quedaban sin gap/color y las filas
   * se veían pegadas y el ícono desalineado del texto.
   */
  .channel-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 32px;
    padding-top: 28px;
  }

  .channel-link {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--cream);
  }

  .channel-ring {
    width: 38px;
    height: 38px;
    border: 1.5px solid rgb(251 242 225 / 0.4);
  }

  .channel-link:hover .channel-ring {
    border-color: rgb(251 242 225 / 0.7);
  }

  .channel-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
</style>

<script>
  // Sin backend en el prototipo: evita el submit real y muestra un acuse
  // (mismo patrón que el formulario de newsletter del Footer).
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const ok = document.querySelector<HTMLElement>('[data-contact-form-ok]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (form.checkValidity()) {
      form.reset();
      ok?.classList.remove('hidden');
    }
  });
</script>
