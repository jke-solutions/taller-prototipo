---
/**
 * "Cursos y Talleres" (servicio del Home → ServicesSection). Listado de los
 * talleres (courses.ts) con el mismo patrón de hero que /catalogo: banda
 * crema con breadcrumb, título y bajada, grid de tarjetas debajo.
 *
 * Modal de inscripción: vive acá (una sola vez) y no en cada CourseCard —
 * cada tarjeta solo dispara el modal con su slug/título vía
 * data-open-inscription (ver script al final). Pide cupos (cuántos niños)
 * en vez de precio: el precio queda oculto en la tarjeta (pedido del
 * cliente) y se conversa por WhatsApp o al confirmar la inscripción. Sin
 * backend real: el submit solo muestra un acuse, mismo patrón que el
 * formulario de Contacto.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import CourseCard from '@sections/services/CourseCard.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import FormField from '@components/ui/FormField.astro';
import FormSelect from '@components/ui/FormSelect.astro';
import { courses } from '@data/courses';
---

<BaseLayout
  title="Cursos y Talleres"
  description="Clases en la azotea para niños y familias: se sientan a crear con sus manos y se llevan su propia pieza a casa."
>
  <div class="bg-cream border-b border-border">
    <div class="wrap pt-10 pb-8 md:pt-14 md:pb-10">
      <p class="font-body text-[13px] text-muted mb-3">
        <a href="/" class="hover:text-ink transition-colors">Inicio</a> /
        <a href="/servicios" class="hover:text-ink transition-colors">Servicios</a> / Cursos y Talleres
      </p>
      <h1 class="font-display text-[34px] md:text-[44px] text-ink tracking-[-0.01em]">Cursos y Talleres</h1>
      <p class="font-body text-[15.5px] md:text-[17px] text-muted mt-3 max-w-[560px]">
        Clases en la azotea para niños y familias: se sientan a crear con sus manos y se llevan su propia pieza a casa.
      </p>
    </div>
  </div>

  <div class="bg-white">
    <div class="wrap py-10 md:py-14">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-reveal>
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
    </div>
  </div>

  <!-- Modal de inscripción: compartido por todas las tarjetas (ver CourseCard.astro) -->
  <div
    class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto bg-[rgba(100,27,11,0.28)] px-4 py-10"
    data-inscription-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="inscription-modal-title"
    hidden
  >
    <div class="w-full max-w-[440px] bg-white border border-border rounded-card p-6 md:p-7 shadow-[0_24px_48px_rgba(100,27,11,0.18)]" data-inscription-modal-panel>
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <p class="font-body text-[12px] font-extrabold uppercase tracking-[0.05em] text-muted mb-1">Inscripción</p>
          <h2 id="inscription-modal-title" class="font-display text-[19px] text-ink leading-[1.25]" data-inscription-course></h2>
        </div>
        <button type="button" class="text-muted shrink-0" aria-label="Cerrar" data-inscription-modal-close>
          <Icon name="close" size={18} />
        </button>
      </div>

      <form class="flex flex-col gap-4" data-inscription-form>
        <input type="hidden" name="taller" data-inscription-taller-input />

        <FormField label="Nombre y apellido" name="nombre" required autocomplete="name" />

        <div class="grid grid-cols-2 gap-4">
          <FormField label="WhatsApp" name="whatsapp" type="tel" required autocomplete="tel" />
          <FormField label="Correo electrónico" name="correo" type="email" autocomplete="email" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <FormField label="Cantidad de cupos" name="cupos" type="number" required />
          <FormSelect label="Horario preferido" name="horario" required>
            <option>10 am – 12 m</option>
            <option>2 pm – 4 pm</option>
          </FormSelect>
        </div>

        <label class="flex items-start gap-[10px] text-[13px] text-muted leading-[1.6]">
          <input type="checkbox" name="acepto" required class="mt-[3px]" />
          Acepto la <a href="/politica-de-privacidad" class="text-ink underline underline-offset-[3px]">Política de Privacidad</a> de Taller Azotea.
        </label>

        <Button type="submit" variant="primary" size="lg">Enviar inscripción</Button>
      </form>

      <div class="hidden flex-col gap-5" data-inscription-success>
        <div class="flex items-center gap-[10px]">
          <span style="color: var(--forest);"><Icon name="check" size={20} /></span>
          <span class="text-[15px] font-bold text-ink">¡Listo! Registramos tu inscripción</span>
        </div>
        <p class="font-body text-[14px] text-muted leading-[1.6]">
          Te confirmamos el cupo por WhatsApp o correo en las próximas horas. (demo — todavía sin backend)
        </p>
        <Button type="button" variant="secondary" size="lg" data-inscription-modal-close>Cerrar</Button>
      </div>
    </div>
  </div>

  <script>
    const modal = document.querySelector<HTMLElement>('[data-inscription-modal]');
    const panel = modal?.querySelector<HTMLElement>('[data-inscription-modal-panel]');
    const courseTitleEl = modal?.querySelector<HTMLElement>('[data-inscription-course]');
    const tallerInput = modal?.querySelector<HTMLInputElement>('[data-inscription-taller-input]');
    const form = modal?.querySelector<HTMLFormElement>('[data-inscription-form]');
    const success = modal?.querySelector<HTMLElement>('[data-inscription-success]');

    const openModal = (courseTitle: string) => {
      if (!modal || !form || !success || !courseTitleEl || !tallerInput) return;
      courseTitleEl.textContent = courseTitle;
      tallerInput.value = courseTitle;
      form.reset();
      form.classList.remove('hidden');
      form.classList.add('flex');
      success.classList.add('hidden');
      success.classList.remove('flex');
      modal.hidden = false;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      if (!modal) return;
      modal.hidden = true;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLButtonElement>('[data-open-inscription]').forEach((btn) => {
      btn.addEventListener('click', () => openModal(btn.dataset.courseTitle ?? ''));
    });

    modal?.querySelectorAll<HTMLElement>('[data-inscription-modal-close]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
    });

    // Sin backend en el prototipo: evita el submit real y muestra el acuse
    // (mismo patrón que el formulario de Contacto).
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) return;
      form.classList.add('hidden');
      form.classList.remove('flex');
      success?.classList.remove('hidden');
      success?.classList.add('flex');
    });
  </script>
</BaseLayout>
