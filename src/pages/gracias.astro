---
/**
 * Página de gracias: llega después de /checkout. El contenido depende 100%
 * del último pedido guardado en localStorage (ver src/scripts/checkout.ts),
 * así que se pinta en el cliente — el markup de acá solo da la estructura y
 * el estado vacío (alguien entra directo sin haber pasado por checkout).
 *
 * Sin pasarela de pago en el prototipo: el botón de WhatsApp arma el mensaje
 * con los datos del pedido para coordinar pago y entrega.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
---

<BaseLayout
  title="Gracias por tu pedido"
  description="Tu pedido fue registrado. Coordina el pago y la entrega por WhatsApp."
>
  <div class="bg-cream">
    <div class="wrap py-14 md:py-20 flex justify-center">
      <div class="hidden flex-col items-center text-center gap-6 max-w-[420px]" data-gracias-empty>
        <div class="w-20 h-20 rounded-full bg-white flex items-center justify-center">
          <Icon name="cart" size={34} class="text-maroon" />
        </div>
        <h1 class="font-display text-[24px] text-ink">No encontramos un pedido reciente</h1>
        <p class="text-[15px] text-muted">Si acabas de comprar, vuelve a intentarlo desde tu carrito.</p>
        <Button href="/catalogo" variant="primary">Ir al catálogo</Button>
      </div>

      <div
        class="hidden flex-col items-center text-center gap-6 w-full max-w-[560px] bg-white border border-border rounded-card p-9 md:p-11"
        data-gracias-content
      >
        <div
          class="w-[76px] h-[76px] rounded-full flex items-center justify-center"
          style="background: color-mix(in oklch, var(--forest) 14%, white);"
        >
          <Icon name="check" size={32} class="text-forest" />
        </div>

        <div class="flex flex-col gap-2">
          <span class="section-eyebrow justify-center" data-gracias-number>Pedido</span>
          <h1 class="font-display text-[30px] text-ink">¡Gracias por tu pedido!</h1>
          <p class="text-[15.5px] leading-relaxed text-muted max-w-[420px] mx-auto">
            Ya registramos tus datos y los del pedido. Solo falta coordinar el pago y la entrega —
            escríbenos por WhatsApp y lo cerramos enseguida.
          </p>
        </div>

        <div class="w-full flex flex-col gap-2 bg-cream rounded-input p-5 text-left" data-gracias-items></div>

        <a
          href="#"
          target="_blank"
          rel="noopener"
          class="w-full inline-flex items-center justify-center gap-2 bg-maroon text-white font-bold rounded-btn py-4 text-[16px]"
          data-gracias-whatsapp
        >
          <Icon name="whatsapp" size={18} />
          Coordinar por WhatsApp
        </a>

        <Button href="/seguimiento" variant="secondary" size="lg" class="w-full" data-gracias-tracking>
          <Icon name="truck" size={16} />
          Seguir mi pedido
        </Button>

        <Button href="/catalogo" variant="link">Volver a la tienda</Button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { getLastOrder, buildOrderWhatsappMessage, type Order } from '@/scripts/checkout';
  import { site } from '@data/site';

  const emptyEl = document.querySelector<HTMLElement>('[data-gracias-empty]');
  const contentEl = document.querySelector<HTMLElement>('[data-gracias-content]');
  const numberEl = document.querySelector<HTMLElement>('[data-gracias-number]');
  const itemsEl = document.querySelector<HTMLElement>('[data-gracias-items]');
  const whatsappEl = document.querySelector<HTMLAnchorElement>('[data-gracias-whatsapp]');
  const trackingEl = document.querySelector<HTMLAnchorElement>('[data-gracias-tracking]');

  function addRow(itemsList: HTMLElement, label: string, value: string, isTotal = false) {
    const row = document.createElement('div');
    row.className = isTotal
      ? 'flex items-center justify-between pt-3 mt-1 border-t border-border'
      : 'flex items-center justify-between text-[13.5px]';

    const labelEl = document.createElement('span');
    labelEl.className = isTotal ? 'font-extrabold text-[14.5px] text-ink' : 'text-muted';
    labelEl.textContent = label;

    const valueEl = document.createElement('span');
    valueEl.className = isTotal ? 'font-display text-[19px] text-maroon' : 'font-bold text-ink';
    valueEl.textContent = value;

    row.append(labelEl, valueEl);
    itemsList.appendChild(row);
  }

  function render(order: Order) {
    if (numberEl) numberEl.textContent = `Pedido N.º ${order.orderNumber}`;

    if (itemsEl) {
      itemsEl.innerHTML = '';
      order.items.forEach((item) => addRow(itemsEl, `${item.name} x${item.qty}`, item.price));
      addRow(itemsEl, order.shippingMethod.label, `S/ ${order.shippingCost.toFixed(2)}`);
      addRow(itemsEl, 'Total', `S/ ${order.total.toFixed(2)}`, true);
    }

    if (whatsappEl) {
      whatsappEl.href = `${site.whatsappHref}?text=${encodeURIComponent(buildOrderWhatsappMessage(order))}`;
    }

    if (trackingEl) {
      trackingEl.href = `/seguimiento?pedido=${encodeURIComponent(order.orderNumber)}`;
    }
  }

  const order = getLastOrder();

  if (!order) {
    emptyEl?.classList.remove('hidden');
    emptyEl?.classList.add('flex');
  } else {
    contentEl?.classList.remove('hidden');
    contentEl?.classList.add('flex');
    render(order);
  }
</script>
